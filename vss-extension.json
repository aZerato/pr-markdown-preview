{
    "manifestVersion": 1,
    "id": "pr-markdown-preview",
    "publisher": "jpctx",
    "version": "1.0.19",
    "name": "Compare Markdown files",
    "description": "Comparison tool for Markdown files in preview mode",
    "public": false,
    "demands": ["api-version/3.0"],
    "categories": ["Azure Repos"],
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services"
        }
    ],
    "scopes": [ "vso.code" ],
    "content": {
        "details": {
            "path": "README.md"
        }
    },
    "icons": {
        "default": "img/world.png"
    },
    "files": [
        {
            "path": "dist",
            "addressable": true
        },
        {
            "path": "img",
            "addressable": true
        }
    ],
    "contributions": [
        {
            "id": "pr-markdown-preview-tab",
            "type": "ms.vss-web.tab",
            "targets": [ "ms.vss-code-web.pr-tabs" ],
            "properties": {
                "name": "Markdown Preview",
                "uri": "dist/PrMarkdownPreview/PrMarkdownPreview.html"
            }
        }
    ]
}
